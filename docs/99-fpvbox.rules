# FPVBox stable device names. Install:
#   sudo cp 99-fpvbox.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# Match the VID/PID set in the P4 firmware (CONFIG_FPV_USB_VID / _PID).
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ENV{ID_USB_INTERFACE_NUM}=="02", SYMLINK+="fpvbox-elrs", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ENV{ID_USB_INTERFACE_NUM}=="04", SYMLINK+="fpvbox-gnss", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ENV{ID_USB_INTERFACE_NUM}=="06", SYMLINK+="fpvbox-ctrl", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="video4linux", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ATTR{index}=="0", SYMLINK+="fpvbox-video", TAG+="uaccess"
# ModemManager must not probe the serial ports.
ATTRS{idVendor}=="1209", ATTRS{idProduct}=="0001", ENV{ID_MM_DEVICE_IGNORE}="1"
