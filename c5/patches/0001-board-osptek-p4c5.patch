+            GPIO13/14, are video lines here) to a UART.
+endchoice
+
+endmenu
diff --git a/main/board.c b/main/board.c
new file mode 100644
index 0000000..bbc9a30
--- /dev/null
+++ b/main/board.c
@@ -0,0 +1,40 @@
+/* C5VRX-5 board profiles: console transport (see board.h). */
+#include "board.h"
+#include <stdio.h>
+#include "esp_err.h"
+#if BOARD_USB_CONSOLE
+#include "driver/usb_serial_jtag_vfs.h"
+#include "hal/usb_serial_jtag_ll.h"
+#else
+#include "driver/uart.h"
+#include "driver/uart_vfs.h"
+#endif
+
+#if BOARD_USB_CONSOLE
+void board_console_init(void) { usb_serial_jtag_vfs_use_nonblocking(); }
+bool board_console_read(uint8_t *c) { return usb_serial_jtag_ll_read_rxfifo(c, 1) != 0; }
+#else
+/* The UART always drains (the ESP32-P4 listens), so output is never lost,
+ * but a FIFO-polling write would busy-wait ~5 us per byte at 2 Mbaud inside
+ * receiver tasks. A small driver TX ring keeps prints asynchronous; if the
+ * heap cannot hold it, fall back to the polled path. */
+#define CONSOLE_TX_RING 1024
+#define CONSOLE_RX_RING 256
+static bool s_driver;
+
+void board_console_init(void)
+{
+    const int port = CONFIG_ESP_CONSOLE_UART_NUM;
+    s_driver = uart_driver_install(port, CONSOLE_RX_RING, CONSOLE_TX_RING, 0, NULL, 0) == ESP_OK;
+    if (s_driver) uart_vfs_dev_use_driver(port);
+    else uart_vfs_dev_use_nonblocking(port);
+    printf("BOARD %s console=uart%d tx=%d rx=%d driver=%u\n", BOARD_NAME, port,
+           CONFIG_ESP_CONSOLE_UART_TX_GPIO, CONFIG_ESP_CONSOLE_UART_RX_GPIO, s_driver);
+}
+
+bool board_console_read(uint8_t *c)
+{
+    if (!s_driver) return false;
+    return uart_read_bytes(CONFIG_ESP_CONSOLE_UART_NUM, c, 1, 0) == 1;
+}
+#endif
diff --git a/main/board.h b/main/board.h
new file mode 100644
index 0000000..770f1b8
--- /dev/null
+++ b/main/board.h
@@ -0,0 +1,44 @@
+/* C5VRX-5 board profiles: pin maps and console transport.
+ *
+ * XIAO ESP32-C5 (upstream): six-bit resistor DAC on D4..D9, optional 40 MHz
+ * clock on D10, USB-Serial-JTAG console.
+ *
+ * OSPTEK ESP32-P4C5 module: the ESP32-C5 talks to the on-module ESP32-P4
+ * over seven fixed traces (SDIO + one IO). They carry the six-bit composite
+ * bus and its 40 MHz clock; the ESP32-P4 decodes the video.
+ *
+ *   C5 GPIO9  -> P4 GPIO18   clock (shift on falling edge)
+ *   C5 GPIO8  -> P4 GPIO14   bit 0
+ *   C5 GPIO7  -> P4 GPIO15   bit 1
+ *   C5 GPIO14 -> P4 GPIO16   bit 2  (C5 USB D+, USB-Serial-JTAG unused)
+ *   C5 GPIO13 -> P4 GPIO17   bit 3  (C5 USB D-)
+ *   C5 GPIO10 -> P4 GPIO19   bit 4
+ *   C5 GPIO2  -> P4 GPIO6    bit 5
+ *
+ * GPIO2 is a video line there, so the IQ loopback lane it carried on the
+ * XIAO moves to GPIO6 (a module pad that must stay unconnected). */
+#pragma once
+#include "sdkconfig.h"
+
+#if CONFIG_C5VRX_BOARD_OSPTEK_P4C5
+#define BOARD_NAME              "osptek-p4c5"
+#define BOARD_IQ_GPIO_NUMS      {1, 0, 25, 6, 27, 5, 3, 4}
+#define BOARD_TX_DATA_GPIO_NUMS {8, 7, 14, 13, 10, 2, -1, -1}
+#define BOARD_TX_CLK_GPIO       9
+#define BOARD_DIGITAL_BUS       1
+#define BOARD_USB_CONSOLE       0
+#else
+#define BOARD_NAME              "xiao-c5"
+#define BOARD_IQ_GPIO_NUMS      {1, 0, 25, 2, 27, 5, 3, 4}
+#define BOARD_TX_DATA_GPIO_NUMS {23, 24, 11, 12, 8, 9, -1, -1}
+#define BOARD_TX_CLK_GPIO       (-1)
+#define BOARD_DIGITAL_BUS       0
+#define BOARD_USB_CONSOLE       1
+#endif
+
+#include <stdbool.h>
+#include <stdint.h>
+/* Console byte transport: USB-Serial-JTAG FIFO or the console UART. */
+void board_console_init(void);
+/* One received byte, never blocks; false when none is waiting. */
+bool board_console_read(uint8_t *c);
