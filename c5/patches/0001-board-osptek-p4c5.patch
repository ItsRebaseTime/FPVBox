diff --git a/sdkconfig.p4c5.defaults b/sdkconfig.p4c5.defaults
new file mode 100644
index 0000000..071a716
--- /dev/null
+++ b/sdkconfig.p4c5.defaults
@@ -0,0 +1,14 @@
+# OSPTEK ESP32-P4C5 module (ESP32-C5HF4, 4 MB flash, no PSRAM). Build with:
+#   idf.py -B build-p4c5 -DSDKCONFIG=sdkconfig.p4c5 "-DSDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.p4c5.defaults" build
+CONFIG_C5VRX_BOARD_OSPTEK_P4C5=y
+CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
+CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"
+# Console on UART1 to the ESP32-P4 (C5 GPIO23 TX -> P4 GPIO22, P4 GPIO23 -> C5 GPIO24).
+# GPIO13/14 (USB D-/D+) carry video bits 3/2, so USB-Serial-JTAG stays off.
+CONFIG_ESP_CONSOLE_UART_CUSTOM=y
+CONFIG_ESP_CONSOLE_UART_CUSTOM_NUM_1=y
+CONFIG_ESP_CONSOLE_UART_TX_GPIO=23
+CONFIG_ESP_CONSOLE_UART_RX_GPIO=24
+CONFIG_ESP_CONSOLE_UART_BAUDRATE=2000000
+CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
+CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
