+    help
+        Selects the pin map, console transport and video output mode.
+
+    config C5VRX_BOARD_XIAO
+        bool "Seeed XIAO ESP32-C5 + resistor DAC (upstream default)"
+
+    config C5VRX_BOARD_OSPTEK_P4C5
+        bool "OSPTEK ESP32-P4C5 module: digital video bus to the ESP32-P4"
